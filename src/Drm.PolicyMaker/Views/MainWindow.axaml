<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Drm.PolicyMaker.ViewModels"
        x:Class="Drm.PolicyMaker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DRM Policy Maker - Unsigned Development Draft"
        Width="1180" Height="760" MinWidth="920" MinHeight="620">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="14">
    <Border Grid.Row="0" Background="#5A3B16" CornerRadius="8" Padding="14">
      <StackPanel Spacing="4">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Policy Maker" />
        <TextBlock Text="이 도구는 서명되지 않은 개발용 Draft만 만듭니다. 운영 정책으로 신뢰할 수 없습니다."
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="18">
      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0" Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="정책 정보" />
          <TextBlock Text="정책 이름" />
          <TextBox Text="{Binding DisplayName}" />
          <TextBlock Text="Policy ID" />
          <TextBox Text="{Binding PolicyId}" IsReadOnly="True" />
          <TextBlock Text="Policy Version" />
          <NumericUpDown Value="{Binding PolicyVersion}" Minimum="1" IsReadOnly="True" />
          <CheckBox IsChecked="{Binding Enabled}" Content="정책 활성화" />
          <CheckBox IsChecked="{Binding ProtectNewFiles}" Content="신규 파일을 보호 후보로 지정" />
          <CheckBox IsChecked="{Binding ProtectExistingFiles}" Content="기존 파일도 보호 후보로 지정" />
          <TextBlock Text="포함 확장자 (줄바꿈 또는 쉼표로 구분)" />
          <TextBox Text="{Binding IncludedExtensions}" AcceptsReturn="True" MinHeight="76" />
          <TextBlock Text="제외 확장자 (줄바꿈 또는 쉼표로 구분)" />
          <TextBox Text="{Binding ExcludedExtensions}" AcceptsReturn="True" MinHeight="76" />
          <TextBlock Text="최대 파일 크기 (bytes, 빈 값은 제한 없음)" />
          <TextBox Text="{Binding MaximumFileSizeBytes}" />
          <TextBlock Text="유효 시작 UTC" FontWeight="SemiBold" />
          <TextBlock Foreground="Gray" Text="아래 날짜와 시간을 UTC 기준으로 저장합니다." />
          <Grid ColumnDefinitions="*,140,48" ColumnSpacing="8">
            <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding ValidFromDate}"
                                PlaceholderText="시작 날짜 선택" />
            <TimePicker Grid.Column="1" SelectedTime="{Binding ValidFromTime}"
                        ClockIdentifier="24HourClock" />
            <Border Grid.Column="2" Background="#263B58" CornerRadius="5" Padding="7,4">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontWeight="SemiBold" Text="UTC" />
            </Border>
          </Grid>
          <TextBlock Margin="0,4,0,0" Text="유효 종료 UTC" FontWeight="SemiBold" />
          <TextBlock Foreground="Gray" Text="종료 제한이 없으면 날짜를 선택하지 마세요." />
          <Grid ColumnDefinitions="*,140,48" ColumnSpacing="8">
            <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding ValidUntilDate}"
                                PlaceholderText="종료 날짜 선택" />
            <TimePicker Grid.Column="1" SelectedTime="{Binding ValidUntilTime}"
                        ClockIdentifier="24HourClock" />
            <Border Grid.Column="2" Background="#263B58" CornerRadius="5" Padding="7,4">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontWeight="SemiBold" Text="UTC" />
            </Border>
          </Grid>

          <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="검증 결과" />
          <ItemsControl ItemsSource="{Binding ValidationErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Foreground="#F08080" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="읽기 전용 JSON 미리보기" />
        <TextBox Grid.Row="1" Text="{Binding JsonPreview}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
      <WrapPanel Orientation="Horizontal">
        <Button Command="{Binding NewPolicyCommand}" Content="새로 만들기" />
        <Button Command="{Binding OpenCommand}" Content="열기" />
        <Button Command="{Binding ValidateCommand}" Content="검증 및 미리보기" />
        <Button Command="{Binding SaveAsCommand}" Content="다른 이름으로 저장" />
      </WrapPanel>
      <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
