<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Drm.Desktop.ViewModels"
        x:Class="Drm.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="700" MinWidth="900" MinHeight="560"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding AppTitle}">
  <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*,Auto,Auto" Margin="28" RowSpacing="16" ColumnSpacing="18">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding WorkspaceTitle}" />
      <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}"
                 Text="{Binding WorkspaceDescription}" />
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="*,8,140">
    <Border Grid.Row="0" MinHeight="120" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="14,10">
              <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" />
              <Border Grid.Row="0" Grid.Column="1" Padding="10,3" CornerRadius="10" Background="{DynamicResource AppAccentSurfaceBrush}">
                <TextBlock Text="{Binding Status}" />
              </Border>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource AppWarningBrush}"
                         Text="{Binding ProtectionNotice}" />
              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource AppAccentBrush}"
                         Text="{Binding MonitorStatus}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Background="{DynamicResource AppBorderBrush}" Cursor="SizeNorthSouth"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <Grid Grid.Row="2" MinHeight="100" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock FontWeight="SemiBold" Text="{Binding RecentObservationsTitle}" />
      <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid MinWidth="1180" RowDefinitions="Auto,*">
            <Border Background="{DynamicResource AppSurfaceElevatedBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
              <Grid ColumnDefinitions="105,100,260,110,120,300,185" ColumnSpacing="12">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding ObservationTimeLabel}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ObservationKindLabel}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding ObservationPathLabel}" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding ObservationCollectionLabel}" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="{Binding ObservationEvaluationLabel}" />
                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="{Binding ObservationReasonLabel}" />
                <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="{Binding ObservationWorkspaceLabel}" />
              </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding RecentObservations}" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceObservationItemViewModel">
                  <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="105,100,260,110,120,300,185" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Text="{Binding ObservedAt}" />
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                      <TextBlock Grid.Column="2" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Path}" />
                      <TextBlock Grid.Column="3" Text="{Binding CollectionStatus}" />
                      <TextBlock Grid.Column="4" Text="{Binding EvaluationStatus}" />
                      <TextBlock Grid.Column="5" Text="{Binding Reason}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Reason}" />
                      <TextBlock Grid.Column="6" Text="{Binding WorkspaceName}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding WorkspaceName}" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    </Grid>

    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
            Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Policy.Title}" />
          <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Policy.Description}" />
          <Button HorizontalAlignment="Left" Command="{Binding Policy.LoadPolicyCommand}"
                  Content="{Binding Policy.LoadLabel}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}" Text="{Binding Policy.StatusMessage}" />

          <StackPanel IsVisible="{Binding Policy.Summary, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Spacing="7" Margin="0,6,0,0">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Policy.Summary.DisplayName}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="10" RowSpacing="5">
              <TextBlock Grid.Row="0" Text="{Binding Policy.NameLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Policy.Summary.DisplayName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="{Binding Policy.IdLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Policy.Summary.PolicyId}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="{Binding Policy.VersionLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Policy.Summary.PolicyVersion}" />
              <TextBlock Grid.Row="3" Text="{Binding Policy.DocumentStateLabel}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Policy.Summary.DocumentState}" />
              <TextBlock Grid.Row="4" Text="{Binding Policy.TrustStateLabel}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource AppWarningBrush}"
                         Text="{Binding Policy.Summary.TrustState}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="{Binding Policy.EnforcementStateLabel}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource AppWarningBrush}"
                         Text="{Binding Policy.Summary.EnforcementState}" />
              <TextBlock Grid.Row="6" Text="{Binding Policy.IncludedLabel}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Policy.Summary.IncludedExtensions}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Text="{Binding Policy.ExcludedLabel}" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Policy.Summary.ExcludedExtensions}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="8" Text="{Binding Policy.MaximumSizeLabel}" />
              <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Policy.Summary.MaximumFileSize}" />
              <TextBlock Grid.Row="9" Text="{Binding Policy.LoadedAtLabel}" />
              <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Policy.Summary.LoadedAt}" />
            </Grid>
            <TextBlock FontWeight="SemiBold" Text="{Binding Policy.SourceLabel}" />
            <TextBlock Text="{Binding Policy.Summary.SourceLocation}" TextWrapping="Wrap" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Policy.ValidationErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
      <Button Command="{Binding AddFolderCommand}" Content="{Binding AddFolderLabel}" />
      <Button Command="{Binding UnregisterCommand}" Content="{Binding UnregisterLabel}" />
      <Button Command="{Binding OpenPathCommand}" Content="{Binding OpenLocationLabel}" />
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ActivityMessage}" />
    </StackPanel>

    <Border Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{DynamicResource AppDangerSurfaceBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
